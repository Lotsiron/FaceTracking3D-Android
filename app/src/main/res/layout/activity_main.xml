<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/mainRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- 1. KATMAN (EN ALT): Donanımsal Kamera -->
    <!-- Kameranın ham görüntüsünü çeker ama biz bunu genellikle
         arka planda gizli çalıştırırız. -->
<!--    <androidx.camera.view.PreviewView-->
<!--        android:id="@+id/viewFinder"-->
<!--        android:layout_width="1dp"-->
<!--        android:layout_height="1dp" />-->

    <!-- 2. KATMAN (ORTA): Yeşil Ekran Tuvalimiz -->
    <!-- İşte geri getirdiğimiz eleman. Kotlin'in (FrameAnalyzer)
         kendi elleriyle çizdiği yeşil ekranlı Bitmap'i her saniye
         bu tuvale fırlatırız. -->
    <ImageView
        android:id="@+id/processedImageView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop" />

    <!-- 3. KATMAN (EN ÜST): 3D Hologram Motoru -->
    <!-- Bu katmanın arka planı tamamen şeffaftır (Transparent).
         Sadece içine koyduğumuz 3D şapkayı çizer. Şeffaf olduğu için
         altındaki ImageView'daki (2. Katman) yeşil ekranlı videomuzu görürüz. -->
    <io.github.sceneview.SceneView
        android:id="@+id/sceneView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>

</FrameLayout>